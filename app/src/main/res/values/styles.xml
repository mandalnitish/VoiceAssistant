<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base style for every plain <Button> in the app (wired up globally
        in themes.xml via materialButtonStyle). Strips the parts of
        MaterialButton that were causing the solid-white background bug:
        the forced backgroundTint, the default insets/padding and the
        elevation state-list animator. Each Button keeps full control of
        its own look via its own android:background drawable.
    -->
    <style name="AppButton.Flat" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Small uppercase section headers: "MODE", "FAN SPEED", "VOLUME"... -->
    <style name="SectionLabel">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

</resources>
