<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="17dp"/>
            <solid android:color="#42212B"/>
            <stroke android:width="1dp" android:color="#D96878"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="17dp"/>
            <solid android:color="#2A1822"/>
            <stroke android:width="1dp" android:color="#7B3B49"/>
        </shape>
    </item>
</selector>