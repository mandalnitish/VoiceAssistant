<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape>

            <solid android:color="#26384D" />

            <corners android:radius="16dp" />

            <stroke
                android:width="1dp"
                android:color="#4A6682" />

        </shape>

    </item>

    <item>

        <shape>

            <solid android:color="#182333" />

            <corners android:radius="16dp" />

            <stroke
                android:width="1dp"
                android:color="#2B4058" />

        </shape>

    </item>

</selector>