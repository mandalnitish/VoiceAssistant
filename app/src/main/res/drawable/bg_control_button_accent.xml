<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="17dp"/>
            <solid android:color="#163A32"/>
            <stroke android:width="1dp" android:color="#55C89A"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="17dp"/>
            <solid android:color="#102A28"/>
            <stroke android:width="1dp" android:color="#2E725F"/>
        </shape>
    </item>
</selector>