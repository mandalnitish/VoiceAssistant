<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#17994C"/>
            <stroke android:width="1dp" android:color="#5EEB9C"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#1E9754" android:endColor="#146138"/>
            <stroke android:width="1dp" android:color="@color/success_border"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</selector>
